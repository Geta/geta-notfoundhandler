<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
    <ItemGroup>
        <SourceScripts
                Include="$(MSBuildThisFileDirectory)..\..\contentFiles\any\any\modules\_protected\**\*.config"/>
    </ItemGroup>

    <!-- Published from the package, as content files don't reach a site that gets this package through another one.
         The copy below must not be picked up as content as well, which would publish the file twice. -->
    <ItemGroup>
        <Content Remove="modules\_protected\Geta.NotFoundHandler.Optimizely\module.config"/>
        <None Include="$(MSBuildThisFileDirectory)..\..\contentFiles\any\any\modules\_protected\Geta.NotFoundHandler.Optimizely\module.config"
              Link="modules\_protected\Geta.NotFoundHandler.Optimizely\module.config"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>

    <Target Name="CopyModule" BeforeTargets="Build">
        <Copy
                SourceFiles="@(SourceScripts)"
                DestinationFolder="$(MSBuildProjectDirectory)\modules\_protected\%(RecursiveDir)"
                SkipUnchangedFiles="true"
        />
    </Target>
</Project>